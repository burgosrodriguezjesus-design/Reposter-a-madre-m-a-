# ════════════════════════════════════════════════════════════════════
#  Variables de entorno — copia este archivo como `.env` y rellénalo.
#  En Vercel: Project → Settings → Environment Variables.
#  Todo lo que no tenga valor queda desactivado de forma segura.
# ════════════════════════════════════════════════════════════════════

# URL pública del sitio, sin barra final (canonical, sitemap, emails, Stripe)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Base de datos PostgreSQL (local con docker-compose, Supabase, Neon...) ──
# En Supabase: DATABASE_URL = cadena "Transaction pooler" (puerto 6543) + ?pgbouncer=true&sslmode=require
#              DIRECT_URL   = cadena "Session/Direct" (puerto 5432), SOLO para migraciones
# En producción DATABASE_URL usa el rol de mínimo privilegio reposteria_app (prisma/sql/least-privilege.sql)
DATABASE_URL=postgresql://reposteria:reposteria@localhost:5432/reposteria?schema=public
DIRECT_URL=postgresql://reposteria:reposteria@localhost:5432/reposteria?schema=public

# Entorno: development | staging | production (en producción la app no arranca si la configuración es insegura)
APP_ENV=development

# ── Cifrado de datos personales (OBLIGATORIO). Genera claves con: npm run keys:generate ──
# Guárdalas en el gestor de secretos del proveedor; cada entorno con claves DISTINTAS.
# Se admiten variables *_FILE (p. ej. DATA_HASH_KEY_FILE=/run/secrets/data_hash_key) para Docker/Kubernetes.
DATA_ENCRYPTION_KEYS=
DATA_ENCRYPTION_ACTIVE_KEY=
DATA_HASH_KEY=

# ── Panel de administración ──
# Primer propietario (lo crea `npm run db:seed`). Contraseña de 12+ caracteres. BÓRRALA tras el primer acceso.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_IDLE_MINUTES=60
ADMIN_SESSION_MAX_HOURS=12
# Dominio para passkeys/llaves de seguridad (por defecto, el de NEXT_PUBLIC_SITE_URL)
WEBAUTHN_RP_ID=
# Comprobar contraseñas en filtraciones públicas (Have I Been Pwned, k-anonimato)
PASSWORD_BREACH_CHECK=true

# ── Red y protección frente a abusos ──
# De quién fiarse para la IP real: vercel | cloudflare | nginx | none
TRUST_PROXY=none
# Redis compartido para límites de peticiones entre instancias (Upstash, Redis gestionado...)
REDIS_URL=
# Solo staging/pruebas de carga: multiplica los límites (en producción se ignora)
RATE_LIMIT_MULTIPLIER=1
# Descarte de carga: retraso del bucle de eventos (ms) a partir del cual se responde 503 en rutas
# no críticas (nunca pedidos, pagos ni panel)
LOAD_SHED_DELAY_MS=1000
# Clave fija de Server Actions si hay varias instancias autoalojadas: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# ── Monitorización y alertas (sin datos personales) ──
METRICS_TOKEN=
ALERT_EMAIL=
ALERT_WEBHOOK_URL=
LOG_LEVEL=info

# HSTS con "preload" (listas de precarga de los navegadores; muy difícil de deshacer). Solo cuando
# todos los subdominios sirvan HTTPS de forma permanente.
HSTS_PRELOAD=false

# ── Divulgación de vulnerabilidades: /.well-known/security.txt (RFC 9116, ver SECURITY.md) ──
# Sin SECURITY_CONTACT la ruta responde 404. Varios contactos separados por comas.
# Ejemplo: mailto:seguridad@tudominio.es · Opcionales (https://...): política y clave OpenPGP.
SECURITY_CONTACT=
SECURITY_POLICY_URL=
SECURITY_ENCRYPTION_URL=

# ── Pagos con Stripe (opcional; sin claves solo se ofrece "pagar en tienda") ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Correo transaccional por SMTP (Resend, Brevo, Gmail Workspace, tu hosting...) ──
# Sin configurar, los correos se muestran en la consola del servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Solo desarrollo con un servidor SMTP local sin TLS. En producción la app se niega a arrancar.
SMTP_ALLOW_PLAINTEXT=false
EMAIL_FROM="Repostería Madre Mía <pedidos@tudominio.es>"

# ── Almacenamiento de fotografías: local | supabase ──
# "local" guarda en UPLOAD_DIR (solo desarrollo o servidor propio con disco persistente).
# En Vercel usa "supabase": un bucket PÚBLICO para fotos de productos (SUPABASE_STORAGE_BUCKET) y
# otro PRIVADO para las fotos de referencia de clientes (SUPABASE_PRIVATE_BUCKET).
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads
SUPABASE_PRIVATE_BUCKET=private
UPLOAD_DIR=

# ── WhatsApp Business Cloud API (opcional, notificaciones automáticas) ──
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Nombre de la plantilla aprobada por Meta para avisar de nuevos pedidos (1 parámetro: resumen)
WHATSAPP_TEMPLATE_NEW_ORDER=
WHATSAPP_TEMPLATE_LANG=es
# Versión de la Graph API de Meta (por defecto v23.0)
WHATSAPP_API_VERSION=

# ── Tareas programadas — Vercel Cron (o tu planificador) envía "Authorization: Bearer CRON_SECRET" ──
#   /api/cron       → diaria (conservación RGPD, recordatorios, verificación de auditoría)
#   /api/cron/jobs  → cada minuto si es posible (cola de emails/avisos y conciliación de pagos)
CRON_SECRET=

# ── Copias de seguridad (scripts/backup.sh) ──
BACKUP_AGE_RECIPIENT=
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=35
